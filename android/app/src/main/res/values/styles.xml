<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">#05070D</item>
        <item name="colorPrimaryDark">#05070D</item>
        <item name="colorAccent">#A45BFF</item>
        <item name="android:windowBackground">#05070D</item>
        <item name="android:statusBarColor">#05070D</item>
        <item name="android:navigationBarColor">#05070D</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">#05070D</item>
        <item name="android:statusBarColor">#05070D</item>
        <item name="android:navigationBarColor">#05070D</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="windowSplashScreenBackground">#05070D</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
